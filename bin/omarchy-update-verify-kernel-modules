#!/bin/bash

# omarchy:summary=Verify required hardware modules before completing an update
# omarchy:hidden=true

set -euo pipefail

# --root also allows validation against a staged installation. Only the stock
# kernel owned by pacman is checked; preserved modules from an earlier boot do
# not describe what the next boot will load.
root=/
if [[ ${1:-} == "--root" && $# == 2 && -d $2 ]]; then
  root=$2
elif (( $# )); then
  echo "Usage: ${0##*/} [--root DIR]" >&2
  exit 2
fi

verifiers=()
for name in verify-snd-hda-macbookpro verify-facetimehd; do
  verifier="${root%/}/usr/lib/omarchy/$name"
  [[ ! -x $verifier ]] || verifiers+=("$verifier")
done
(( ${#verifiers[@]} )) || exit 0

# No stock kernel is valid on systems that deliberately use an alternative.
installed=$(pacman --root "$root" -Qq)
if ! grep -Fxq linux <<< "$installed"; then
  exit 0
fi
files=$(pacman --root "$root" -Qlq linux)
targets=""
while IFS= read -r file; do
  target=${file#"${root%/}/"}
  if [[ $target =~ ^usr/lib/modules/[^/]+/modules\.order$ ]]; then
    targets+="$target"$'\n'
  fi
done <<< "$files"
if [[ -z $targets ]]; then
  echo "ERROR: Cannot determine the installed stock kernel for hardware verification." >&2
  exit 1
fi

failed=false
for verifier in "${verifiers[@]}"; do
  if ! "$verifier" --modules-root "${root%/}/usr/lib/modules" <<< "$targets"; then
    failed=true
  fi
done

if [[ $failed == "true" ]]; then
  echo "Required hardware drivers are missing. The update is incomplete; do not reboot into the new kernel." >&2
  echo "Repair the driver packages or restore the previous kernel and matching headers before rebooting." >&2
  exit 1
fi
